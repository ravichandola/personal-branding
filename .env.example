NODE_ENV=development

# App — must match the port you use for `next dev` (see AUTH_URL below)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Database (Postgres)
# Local:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ravi_brand
#
# Neon (copy from dashboard → Connection string → Prisma):
# - Free projects suspend after inactivity: open https://console.neon.tech and wake the project if you see "Can't reach database server".
# - Always include SSL, e.g. ?sslmode=require (Neon's UI usually appends this).
# - If connections drop under load, try the "Pooler" / pooled connection string from Neon instead of the direct host.
# Optional: add connect_timeout=15 to the query string if you hit cold-start timeouts.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ravi_brand

# Auth.js / NextAuth — AUTH_URL origin MUST match the URL you open in the browser (including port)
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_ADMIN_EMAILS=you@yourdomain.com

# Admin bootstrap for Prisma seed only
ADMIN_BOOTSTRAP_EMAIL=you@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

# Email — contact alerts via Resend (https://resend.com)
# - RESEND_API_KEY: required for mail delivery
# - CONTACT_NOTIFY_EMAIL and/or Admin → Site → Contact form notify email (DB is preferred for display + delivery)
# - RESEND_FROM_EMAIL must use a verified domain (resend.com/domains). Leave unset locally to fall back to onboarding@resend.dev (sandbox rules apply).
RESEND_API_KEY=
# RESEND_FROM_EMAIL="Portfolio <noreply@yourdomain.com>"
CONTACT_NOTIFY_EMAIL=you@yourdomain.com
# Fallback if Settings row has no "Contact form notify email" (bootstrap / local)
# CONTACT_ALERT_EMAIL=you@yourdomain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blog: Medium RSS import (npm run db:sync-medium). Optional:
# MEDIUM_FEED_URL=https://medium.com/feed/@ravichandola
# Full archive + topic categories: MEDIUM_EXPORT_ZIP=/path/to/export.zip npm run db:import-medium-export

# AI (future)
OPENAI_API_KEY=
