NODE_ENV=development

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ravi_brand

# Auth.js / NextAuth compatible
AUTH_SECRET=replace-with-openssl-rand-hex-32
# Use the same origin + port as `next dev` (3000 or 3001)
AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_ADMIN_EMAILS=you@yourdomain.com

# Admin bootstrap for Prisma seed only
ADMIN_BOOTSTRAP_EMAIL=you@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio <noreply@yourdomain.com>"
CONTACT_NOTIFY_EMAIL=you@yourdomain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (future)
OPENAI_API_KEY=
